# ============================================
# CONFIGURACIÓN DE ENTORNO
# Copia este archivo como .env y llena los valores
# ============================================

# Puerto del servidor Express
PORT=3000

# Configuración de PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reddit_binary_tree
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# Secret para JWT (cámbialo por una cadena aleatoria larga y segura)
JWT_SECRET=mi_super_secreto_jwt_cambiar_en_produccion

# Secret para Express Session
SESSION_SECRET=mi_super_secreto_session_cambiar_en_produccion

# Entorno
NODE_ENV=development
